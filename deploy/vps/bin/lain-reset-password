#!/usr/bin/env bash
# A new random password for a player who forgot theirs.
#   lain-reset-password "Nombre"
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo "Ejecuta como root." >&2; exit 1; }
name=${1:?Uso: lain-reset-password NOMBRE}
cd /opt/lain
runuser -u lain -- env PYTHONDONTWRITEBYTECODE=1 LAIN_ONLINE=1 /opt/lain-venv/bin/python -m tools.online_server \
  --data-dir /var/lib/lain reset-password --name "$name"
