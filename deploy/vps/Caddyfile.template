# Written by deploy/vps/setup.sh. Caddy gets and renews the HTTPS certificate.
__HOST__ {
	encode gzip
	# Mutually exclusive, first match wins: docs closed, download page, World Core.
	@docs path /docs /docs/* /redoc /openapi.json
	handle @docs {
		respond 404
	}
	@site path / /index.html
	handle @site {
		root * /opt/lain/deploy/vps/web
		rewrite * /index.html
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:8000
	}
}
